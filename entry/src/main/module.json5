{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],

    "extensionAbilities": [
      {
        "name": "ChatGPTFormAbility",
        "srcEntry": "./ets/entryformability/ChatGPTFormAbility.ets",
        "label": "ChatGPT 桌面卡片",
        "description": "与 ChatGPT 互动的桌面卡片",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_BUNDLE_INFO",
        "reason": "$string:get_bundle_info_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
      // 以下两个权限已移除，声明了会导致安装被系统拒绝（错误码 9568289）：
      //   ohos.permission.GET_BUNDLE_INFO_PRIVILEGED  availableLevel=system_basic, availableType=ENTERPRISE_NORMAL
      //   ohos.permission.BUNDLE_ACTIVE_INFO          availableLevel=system_basic, availableType=SYSTEM
      // 二者均只发放给系统应用/企业应用，个人开发者证书拿不到。
      // 当前数据源为模拟实现（见 service/UsageAnalyzer.ets），本就不需要这两个权限。
    ]
  }
}
